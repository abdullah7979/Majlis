{
  "name": "majlis",
  "productName": "Majlis",
  "version": "0.1.0",
  "description": "One desktop app for all your AI subscriptions — smart routing and automatic fallback across Claude Code, Codex and Gemini CLI.",
  "main": "src/main/main.js",
  "author": "abdullah7979",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/unit.test.js test/orchestrator.test.js",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --win --publish never",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "@highlightjs/cdn-assets": "^11.12.0",
    "dompurify": "^3.4.18",
    "electron-updater": "^6.8.11",
    "marked": "^18.2.1"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.abdullah7979.majlis",
    "productName": "Majlis",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Majlis-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Majlis"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "abdullah7979",
        "repo": "majlis",
        "releaseType": "release"
      }
    ]
  }
}
